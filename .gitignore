# Repo-wide ignores. Platform build artifacts live in osx/.gitignore and windows/.gitignore.

# macOS / OS cruft
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.swp
*~

# Local reference checkouts (not part of this repo)
# Magic Trackpad 2 Windows driver: vitoplantamura/MagicTrackpad2ForWindows + signed package/PDBs
reference_win_driver/

# Signing material must never be committed (certificates, update-signing keys).
*.p12
*.key
