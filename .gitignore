# Repo-wide ignores. Platform build artifacts live in osx/.gitignore and windows/.gitignore.

# macOS / OS cruft
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.swp
*~

# Local reference checkouts (not part of this repo)
# Magic Trackpad 2 Windows driver: vitoplantamura/MagicTrackpad2ForWindows + signed package/PDBs
reference_win_driver/
# Offline Logitech Flow simulator (ctpahhik/offline_logitech_flow_simulator) + HID++ 2.0 docs:
# reference for host-initiated channel switching (feature 0x1814 Change Host)
reference_flow/
# ZMK firmware (zmkfirmware/zmk) and the user's zmk-config (Reviung41): references for the
# AutoSwitch ZMK module (casab/zmk-autoswitch)
zmk_main_reference/
zmk_reference/

# Signing material must never be committed (certificates, update-signing keys).
*.p12
*.key
*.pfx
*.pem
