<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AutoSwitchKVM.App.TrayPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AutoSwitchKVM.App.ViewModels">

    <!-- Quick-settings style panel: status, devices with toggles, profile, quick actions. -->
    <!-- Host grid: the window's root element can't be measured directly (Measure on it throws), so the
         panel content is one level down and sized from Root.DesiredSize. -->
    <Grid>
    <!-- Gaps are top margins, not StackPanel.Spacing: Spacing also counts collapsed children (the
         empty-state text and the profile picker), which left a gap at the bottom. -->
    <StackPanel x:Name="Root" Padding="12" VerticalAlignment="Top" SizeChanged="OnRootSizeChanged">

        <!-- Status -->
        <Border Style="{StaticResource SurfaceCardStyle}" Padding="14,12,6,12">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center"
                        Background="{x:Bind ViewModel.StatusBackground, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}" FontSize="18"
                              Foreground="{x:Bind ViewModel.StatusForeground, Mode=OneWay}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <!-- The detail line is left out here: the device rows below already show it. -->
                <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SubtleButtonStyle}" Padding="8,6"
                        Click="OnOpenSettings" ToolTipService.ToolTip="Open AutoSwitch KVM settings">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <!-- Devices -->
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices}" Margin="0,8,0,0">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="4" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceViewModel">
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEFA5;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing Width="12" Height="12" IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{x:Bind PillForeground, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                          IsOn="{x:Bind IsConnected, Mode=OneWay}" IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}"
                                          Toggled="OnDeviceToggled"
                                          ToolTipService.ToolTip="Connect or release this device" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <TextBlock Text="No devices yet. Add one in Settings." Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,8,2,0"
                   Visibility="{x:Bind ViewModel.NoDevices, Mode=OneWay}" />

        <!-- Profile -->
        <ComboBox HorizontalAlignment="Stretch" Header="Profile" Margin="0,8,0,0"
                  ItemsSource="{x:Bind ViewModel.Profiles}"
                  SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                  Visibility="{x:Bind ViewModel.HasMultipleProfiles, Mode=OneWay}" />

        <!-- Quick actions (tiles) -->
        <Grid ColumnSpacing="8" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton HorizontalAlignment="Stretch" Height="56" IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}"
                          ToolTipService.ToolTip="Ignore KVM switches until you resume">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE769;" FontSize="16" />
                    <TextBlock Text="Pause" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <Button Grid.Column="1" HorizontalAlignment="Stretch" Height="56" Click="{x:Bind ViewModel.ConnectAll}"
                    ToolTipService.ToolTip="Connect every device now">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE71B;" FontSize="16" />
                    <TextBlock Text="Connect all" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" HorizontalAlignment="Stretch" Height="56" Click="{x:Bind ViewModel.DisconnectAll}"
                    ToolTipService.ToolTip="Release every device for the other computer">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE8CD;" FontSize="16" />
                    <TextBlock Text="Release all" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
    </Grid>
</Window>
