<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AutoSwitchKVM.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Unpackaged (no MSIX identity): the Windows App SDK bootstrapper auto-initializer is
         injected automatically when WindowsPackageType=None. See windows/PLAN.md (distribution). -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Program.cs: Velopack must run before WinUI starts, so we supply Main. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Release metadata. Version is overridden by the release build (tools/release.ps1 / CI passes
         -p:Version from the v* tag); the default marks local builds. -->
    <Version>0.0.0-dev</Version>
    <Product>AutoSwitch KVM</Product>
    <AssemblyTitle>AutoSwitch KVM</AssemblyTitle>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>

    <!-- Publish (release builds, tools/release.ps1). ReadyToRun precompiles the IL so startup skips
         most JIT work; bigger package, faster start. Trimming / Native AOT: see windows/PLAN.md
         "Distribution: size and startup" before trying. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions are a known-good baseline; Visual Studio may offer newer servicing builds - bump
         freely. If NuGet restore fails on a version string, update to the latest available.
         NOTE: H.NotifyIcon.WinUI 2.1.0 predates Windows App SDK 2.x — the pairing builds, but
         validate tray behavior on-device after any WindowsAppSDK bump, and bump the two together
         when a matching H.NotifyIcon release exists. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.0" />
    <!-- WMI: Win32_PnPEntity enumeration + Win32_DeviceChangeEvent watch (PnpUsbMonitor). -->
    <PackageReference Include="System.Management" Version="10.0.9" />
    <!-- System integration (Milestone 6): registry Run key + power/sleep events. WinUI 3 (no
         WindowsDesktop.App ref) doesn't ship these in-box, so reference them explicitly. -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.9" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- HID access for Logitech HID++ "Change Host" (Platform/LogitechHostSwitcher.cs). MIT. -->
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <!-- The Microsoft.WindowsAppSDK metapackage also pulls the AI/ML components (onnxruntime.dll +
         DirectML.dll, ~40 MB) and Widgets, none of which the app uses. A direct reference with
         ExcludeAssets="all" drops their files. Keep these versions in step with the metapackage's
         dependencies when bumping it (a mismatch shows up as restore warning NU1605 / NU1608). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.2.3" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.70" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.70" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoSwitchKVM.Core\AutoSwitchKVM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icons (monitor glyph matching the macOS menu-bar symbol) + state variants
         (active/inactive/paused/off). Content so ms-appx:/// resolves them; Remove from the default
         None glob first to avoid a duplicate-item error. -->
    <None Remove="Assets\*.ico;Assets\*.png" />
    <Content Include="Assets\*.ico;Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
