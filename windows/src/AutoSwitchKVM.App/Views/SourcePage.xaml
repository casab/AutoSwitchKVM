<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoSwitchKVM.App.Views.SourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}"
                    Spacing="{StaticResource SettingsCardSpacing}">

            <TextBlock Text="KVM source" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="1,0,0,12"
                       Text="The source is the USB device (usually a hub inside the KVM) that is only connected while the KVM is on this PC. When it appears, devices connect; when it disappears, they are released." />

            <!-- Current source -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="24" VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                        <FontIcon Glyph="&#xE88E;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SourceName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SourceIds, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SourcePresence, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{x:Bind ViewModel.SourcePresenceBrush, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Set up" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="Learn from a switch"
                                  Description="Switch the KVM away and back while AutoSwitch watches. It finds the devices that change. Recommended.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;" /></toolkit:SettingsCard.HeaderIcon>
                <Button Content="Learn…" Style="{StaticResource AccentButtonStyle}" Click="OnLearn" MinWidth="108" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Pick from connected devices"
                                  Description="Choose the KVM's devices from everything connected to this PC right now.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8FD;" /></toolkit:SettingsCard.HeaderIcon>
                <Button Content="Pick…" Click="OnPick" MinWidth="108" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Enter IDs manually"
                                  Description="Type the vendor and product IDs (hex) if you already know them.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE70F;" /></toolkit:SettingsCard.HeaderIcon>
                <Button Content="Edit…" Click="OnEdit" MinWidth="108" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Remove source" Description="Stop following the KVM until you set up a new source."
                                  Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" /></toolkit:SettingsCard.HeaderIcon>
                <Button Content="Remove" Click="OnRemove" MinWidth="108" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
