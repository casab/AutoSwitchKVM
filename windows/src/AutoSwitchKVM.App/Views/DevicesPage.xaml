<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoSwitchKVM.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:AutoSwitchKVM.App.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}"
                    Spacing="{StaticResource SettingsCardSpacing}">

            <Grid>
                <TextBlock Text="Devices" Style="{StaticResource PageTitleStyle}" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0"
                        Style="{StaticResource AccentButtonStyle}" Click="OnAddDevice">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add device" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="1,0,0,12"
                       Text="These Bluetooth devices follow the KVM: they connect when it switches to this PC and are released when it switches away. They connect in list order." />

            <toolkit:SettingsCard Header="No devices yet" Description="Add the trackpad or keyboard you share between computers."
                                  Visibility="{x:Bind ViewModel.NoDevices, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE702;" /></toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <ItemsRepeater x:Name="DeviceList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="{StaticResource SettingsCardSpacing}" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceViewModel">
                        <toolkit:SettingsExpander Header="{x:Bind Name, Mode=OneWay}" Description="{x:Bind Detail, Mode=OneWay}"
                                                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                            <toolkit:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" />
                            </toolkit:SettingsExpander.HeaderIcon>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                              Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                                <Border Style="{StaticResource PillBorderStyle}" Background="{x:Bind PillBackground, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{x:Bind PillForeground, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </Border>
                                <Button Content="{x:Bind PrimaryActionText, Mode=OneWay}" Click="{x:Bind PrimaryAction}"
                                        IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}" MinWidth="108" />
                            </StackPanel>

                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard Header="{x:Bind HandoffTitle, Mode=OneWay}"
                                                      Description="{x:Bind HandoffDescription, Mode=OneWay}">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind HandoffGlyph, Mode=OneWay}" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <HyperlinkButton Content="Which devices can switch?" NavigateUri="https://autoswitchkvm.com/devices/" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="Other computer's channel"
                                                      Description="{x:Bind ChannelSettingDescription, Mode=OneWay}"
                                                      Visibility="{x:Bind ChannelSettingVisibility, Mode=OneWay}">
                                    <ComboBox ItemsSource="{x:Bind ChannelChoices, Mode=OneWay}" MinWidth="140"
                                              SelectedIndex="{x:Bind ReleaseChannelIndex, Mode=TwoWay}" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="Follow the KVM"
                                                      Description="Connect and release this device automatically when the KVM switches.">
                                    <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="Manage pairing"
                                                      Description="Pair when connecting and unpair when releasing. Required for devices that can only be paired with one computer at a time, like the Magic Trackpad.">
                                    <ToggleSwitch IsOn="{x:Bind ManagePairing, Mode=TwoWay}" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="Connect delay"
                                                      Description="Wait this long (milliseconds) before connecting. Use it to stagger several devices.">
                                    <NumberBox Value="{x:Bind ConnectDelayMs, Mode=TwoWay}" Minimum="0" Maximum="60000"
                                               SmallChange="100" LargeChange="1000" MinWidth="140"
                                               SpinButtonPlacementMode="Compact" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="Manual control" Description="Pair or unpair by hand, or write a diagnostic report to the log.">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Pair" Click="{x:Bind Pair}" />
                                        <Button Content="Unpair" Click="{x:Bind Unpair}" />
                                        <Button Content="Diagnose" Click="{x:Bind Diagnose}" />
                                    </StackPanel>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="Order and removal">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="{x:Bind MoveUp}" IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"
                                                ToolTipService.ToolTip="Move up">
                                            <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                        </Button>
                                        <Button Click="{x:Bind MoveDown}" IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"
                                                ToolTipService.ToolTip="Move down">
                                            <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                        </Button>
                                        <Button Click="OnRemoveDevice" Tag="{x:Bind}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="Remove" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
