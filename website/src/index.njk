---
layout: base.njk
---
{# ---------- Hero ---------- #}
<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Free for Mac and Windows</p>
      <h1><span class="nowrap">Press the KVM button.</span><br><span class="hl nowrap">Your devices follow.</span></h1>
      <p class="lead">
        Your KVM switch moves the screen and the USB devices. AutoSwitch KVM moves your
        <strong>Bluetooth</strong> keyboard, mouse, trackpad and headphones along with it.
        No Bluetooth settings, no re-pairing, no channel keys.
      </p>
      <div class="cta" data-downloads>
        <a class="btn btn--primary" data-os="mac" href="{{ site.download.mac }}">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 21h14"/></svg>
          Download for Mac
        </a>
        <a class="btn btn--ghost" data-os="windows" href="{{ site.download.windows }}">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 21h14"/></svg>
          Download for Windows
        </a>
      </div>
      <p class="fineprint">macOS 13+ · Windows 10 &amp; 11 · No account, no tracking</p>
    </div>

    {# The interactive desk. site.js runs it; without JS it shows the Mac side, still and cute. #}
    <figure class="demo" data-demo data-active="mac">
      <div class="desk">
        {# Cables from the KVM to each computer (drawn first, under everything); the active one glows. #}
        <svg class="cables" viewBox="0 0 400 330" preserveAspectRatio="none" aria-hidden="true">
          <path class="cable cable--mac" d="M150 284 C 112 284, 88 240, 88 150"/>
          <path class="cable cable--pc" d="M250 284 C 288 284, 312 240, 312 150"/>
        </svg>

        <div class="computer computer--mac">
          <span class="computer__label">Mac</span>
          <svg viewBox="0 0 200 160" aria-hidden="true">
            <rect class="computer__body" x="6" y="6" width="188" height="122" rx="14"/>
            <rect class="computer__screen" x="16" y="16" width="168" height="102" rx="7"/>
            <g class="computer__awake">
              <rect class="computer__window" x="34" y="32" width="88" height="56" rx="6"/>
              <rect class="computer__window computer__window--alt" x="96" y="56" width="70" height="44" rx="6"/>
              <path class="computer__cursor" d="M120 70l0 22 6-6 5 11 4-2-5-10 8 0z"/>
            </g>
            <g class="computer__asleep">
              <text x="100" y="78">z z z</text>
            </g>
            <path class="computer__stand" d="M86 128h28l6 20H80z"/>
            <rect class="computer__foot" x="66" y="146" width="68" height="8" rx="4"/>
          </svg>
        </div>

        <div class="computer computer--pc">
          <span class="computer__label">PC</span>
          <svg viewBox="0 0 200 160" aria-hidden="true">
            <rect class="computer__body" x="6" y="6" width="188" height="122" rx="14"/>
            <rect class="computer__screen" x="16" y="16" width="168" height="102" rx="7"/>
            <g class="computer__awake">
              <rect class="computer__window" x="30" y="28" width="96" height="60" rx="4"/>
              <rect class="computer__window computer__window--alt" x="104" y="52" width="66" height="48" rx="4"/>
              <path class="computer__cursor" d="M76 60l0 22 6-6 5 11 4-2-5-10 8 0z"/>
            </g>
            <g class="computer__asleep">
              <text x="100" y="78">z z z</text>
            </g>
            <path class="computer__stand" d="M86 128h28l6 20H80z"/>
            <rect class="computer__foot" x="66" y="146" width="68" height="8" rx="4"/>
          </svg>
        </div>

        {# The buddies: the trackpad leads, the keyboard follows a beat later, and the headphones
           hop off the top of one monitor onto the other. #}
        <div class="buddy buddy--trackpad">
          <div class="buddy__hop">
            <svg viewBox="0 0 90 70" aria-hidden="true">
              <rect class="buddy__shape" x="4" y="6" width="82" height="58" rx="12"/>
              <g class="buddy__eyes"><circle cx="32" cy="30" r="5"/><circle cx="58" cy="30" r="5"/></g>
              <path class="buddy__smile" d="M36 42q9 8 18 0"/>
              <circle class="buddy__blush" cx="22" cy="42" r="5"/><circle class="buddy__blush" cx="68" cy="42" r="5"/>
            </svg>
          </div>
          <span class="buddy__name">Trackpad</span>
        </div>
        <div class="buddy buddy--keyboard">
          <div class="buddy__hop">
